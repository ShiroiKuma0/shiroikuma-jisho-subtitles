#!/usr/bin/env bash
#
# shiroikuma-jisho-subtitles — turn an EPUB and its audiobook into
# one-sentence-per-cue SRT files for the shiroikuma-jisho Android app.
#
# This wrapper documents the tool and hands everything else to the Python
# package in its own virtualenv.  The real work lives in jisho_subs/.

set -euo pipefail

VENV="${JISHO_SUBS_VENV:-$HOME/venv.shiroikuma-jisho-subtitles}"
REPO="${JISHO_SUBS_REPO:-$HOME/git/shiroikuma-jisho-subtitles}"
PROG=$(basename "$0")

if [[ -t 2 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    R=$'\033[0m'; B=$'\033[1m'; Y=$'\033[1;33m'; C=$'\033[1;36m'
    G=$'\033[1;32m'; M=$'\033[1;35m'; D=$'\033[2m'; E=$'\033[1;31m'
else
    R='' B='' Y='' C='' G='' M='' D='' E=''
fi

die() { printf '%s[%s] error:%s %s\n' "$E" "$PROG" "$R" "$*" >&2; exit 1; }

print_help() {
cat <<EOF
${Y}${PROG}${R} — sentence-aligned subtitles from an EPUB and its audiobook

${C}SYNOPSIS${R}
    ${PROG} ${C}[run]${R} ${C}BOOKDIR${R} [options]
    ${PROG} ${C}convert${R}   ${C}BOOKDIR${R}     convert MP3 to M4B, then stop
    ${PROG} ${C}sentences${R} ${C}BOOKDIR${R}     print the text as it will be cued
    ${PROG} ${C}probe${R}     ${C}BOOKDIR${R}     show what would be used, do nothing
    ${PROG} ${C}lint${R}      ${C}AUDIODIR${R}    check SRTs against the app's parser

    ${PROG} ${C}-s${R}                     set up, or check, this machine
    ${PROG} ${C}-s --rebuild${R}           throw the environment away and rebuild it

    ${C}BOOKDIR${R} is positional; ${C}--dir${R} ${C}BOOKDIR${R} is accepted too.  ${B}Note that -d
    means delete${R} — see DELETING THE MP3s.

${C}WHAT IT IS FOR${R}
    In shiroikuma-jisho you open a foreign-language EPUB, a translation EPUB,
    an audiobook and an SRT.  The player speaks ${B}one subtitle and stops${R}, so you
    can read the line, look words up, and check the translation before moving
    on.  That only works if every subtitle is exactly one whole sentence, timed
    tightly enough that the stop lands in the narrator's pause.

    This produces those SRTs from any EPUB and any audiobook — one file or two
    hundred — unattended.  The subtitle text is the ${B}book's own${R}, never the
    transcriber's, so spelling and punctuation are the author's.

${C}WHAT IT DOES, IN ORDER${R}
    ${B}0. Convert${R}   If the audio is MP3, it is converted to M4B ${B}first${R}, before
                anything else, and everything downstream works on the M4B.
                See MP3 CONVERSION below for why this is not optional.

    ${B}1. Read${R}      The EPUB is walked in spine order.  Text is extracted
                block by block so inline markup adds no spaces — a drop cap
                <span>A</span>m Rand stays "Am Rand".  Japanese ruby readings
                are removed.  A table of contents sitting in the reading spine
                is detected structurally and dropped.  The text is then split
                into sentences with per-language rules.

    ${B}2. Listen${R}    Every audio file is transcribed with Whisper large-v3
                (word-level timestamps), primed with proper nouns mined from
                the book so names are not mangled.  Results are cached, so
                every later run of the same book is nearly instant.

    ${B}3. Align${R}     The whole book is matched against the whole audiobook in
                one pass — there is no chapter matching, and none is needed.
                Anchors are found across the entire text, then a finer
                edit-distance pass fills the gaps between them.

    ${B}4. Snap${R}      Each cue's end is moved into the narrator's following
                pause using voice-activity detection, and starts that Whisper
                placed on a word that is not there are pulled to the real
                speech.  This is what makes the app's auto-pause land cleanly.

    ${B}5. Write${R}     One SRT per audio file, ${B}named after the audio file${R} and
                written beside it — which is exactly how the app finds it, with
                no further action.

    ${B}6. Report${R}    Everything discarded is named.  Silent loss is the failure
                that wastes study time, so nothing vanishes quietly.

${C}WHAT IT DROPS BY ITSELF${R}
    Nothing below needs configuring.  Text with no matching audio and audio
    with no matching text both fall out of the alignment on their own:

      ${D}·${R} covers, half-titles, blurbs, author vitas, imprints, publisher
        notes, dedications, printed section numbers, newsletter pages,
        endnotes, tables of contents, DRM watermark strings
      ${D}·${R} "Sie hören … ein Hörbuch des Argon Verlags", "Wydawnictwo Znak …
        czyta …", and the outro that repeats it
      ${D}·${R} a whole audio file containing no book text — a publisher intro
        track — which produces no SRT and is reported as such

${C}MP3 CONVERSION${R}
    The app cannot seek MP3.  Its own warning says the Android player lands
    several seconds from the requested position and that ${B}auto-pause fires at
    the wrong sentence boundaries${R} — which defeats the whole point of aligning
    cues precisely.  MP4 carries a sample-accurate index; MP3 does not.

    So MP3 books are converted to M4B before anything else, with the exact
    ffmpeg invocation the app's dialog recommends:

        ${D}ffmpeg -i IN.mp3 -map 0 -c:a aac -b:a 128k \\
               -c:v copy -disposition:v attached_pic OUT.m4b${R}

    The M4B is written ${B}beside${R} its MP3, under the same basename, so one SRT
    pairs with either.  ${M}Your MP3s are never touched or deleted.${R}  Because the
    app lists every audio file in a folder, its chapter list will show each
    track twice until you remove the MP3s yourself — the tool prints the exact
    command and deliberately does not run it.

    Timings are always regenerated from the M4B, never carried over from the
    MP3: AAC encoder delay shifts the audio by tens of milliseconds, which is
    the difference between a pause and a clipped syllable.

    Pass ${C}--keep-mp3${R} to skip conversion entirely.

${C}DELETING THE MP3s${R}  ${E}(-d, destructive)${R}
    By default the MP3s are kept, so one folder ends up holding both copies of
    every track.  The tool itself ignores the MP3s once M4Bs exist, but ${B}the app
    does not${R} — it lists every audio file in a folder, so its chapter list will
    show each track twice until the MP3s go.

    ${C}-d${R} deletes them, once conversion has finished:

      ${D}·${R} each MP3 is removed only after ${B}its own${R} M4B has been verified — the
        file must probe as real audio and be the same length, so a truncated
        or half-written conversion can never take the original with it
      ${D}·${R} any MP3 whose replacement fails that check is ${B}kept${R}, and the reason
        is printed
      ${D}·${R} you are asked first, and a bare Enter means ${B}no${R}.  ${C}-y${R} skips the
        prompt for unattended runs.

    ${M}This is irreversible.${R}  Nothing else in this tool deletes anything, ever;
    generated SRTs are overwritten in place on a re-run, but no audio is
    touched unless you pass -d.

${C}OPTIONS${R}

  ${B}Accepted by run, convert, sentences and probe${R}
    ${C}BOOKDIR${R}               the book's directory: the EPUB and the audio.  The
                          audio may sit loose in it or in one subdirectory.
    ${C}--dir${R} DIR             the same thing, named rather than positional
    ${C}--epub${R} FILE           use this EPUB or PDF, instead of searching BOOKDIR
    ${C}--audio${R} DIR           use this audio directory, instead of searching
    ${C}-l, --lang${R} CODE       de, ja, pl, ru, en, fr, es, it, nl, zh.  Read from
                          the EPUB's own metadata when omitted.

  ${B}run${R} — the whole pipeline ${D}(the default; the word may be left out)${R}
    ${C}-n, --dry-run${R}         plan only.  Converts nothing, deletes nothing,
                          writes nothing — it aligns and reports so you can see
                          what would happen.  On an unconverted book it aligns
                          against the MP3s and says the timings will shift.
    ${C}-o, --out${R} DIR         write the SRTs here instead of beside each audio
                          file.  Beside is the default because that is what
                          makes the app attach them by itself.
    ${C}--keep-mp3${R}            do not convert MP3 to M4B at all
    ${C}-d, --delete-mp3${R}      ${E}DESTRUCTIVE${R}: delete each MP3 once its own M4B is
                          verified.  Asks first — see DELETING THE MP3s.
    ${C}-y, --yes${R}             answer that question with yes, for unattended runs
    ${C}--convert-to${R} DIR      put converted audio somewhere other than beside
                          the MP3 it came from
    ${C}--jobs${R} N              how many files to convert at once
                          ${D}(default: one per core, up to 16)${R}
    ${C}--model${R} NAME          Whisper model ${D}(default: large-v3)${R}
    ${C}--device${R} auto|cuda|cpu
                          ${D}(default: auto — CUDA when CTranslate2 sees a GPU)${R}
    ${C}--batch-size${R} N        Whisper batch size ${D}(default: 32)${R}
    ${C}--beam-size${R} N         Whisper beam size ${D}(default: 1)${R}
    ${C}--cache-dir${R} DIR       where transcripts and voice-activity results live
                          ${D}(default: ~/.cache/jisho-subs)${R}
    ${C}--no-refine${R}           skip snapping cue ends into the narrator's pauses
    ${C}--force${R}               ignore the cache and redo the transcription
    ${C}--report${R} FILE         also save the run report here
    ${C}--json${R} FILE           save a machine-readable report: every cue, its
                          timing, its confidence, and what was dropped
    ${C}-v, --verbose${R}         name every file as it is written

  ${B}convert${R} — fix the audio format and stop
    ${C}-d, --delete-mp3${R}      ${E}DESTRUCTIVE${R}: delete each MP3 once its M4B verifies
    ${C}-y, --yes${R}             skip the confirmation
    ${C}--convert-to${R} DIR      where the M4Bs go
    ${C}--jobs${R} N              parallel conversions
    ${C}--force${R}               re-convert even where an M4B already exists

  ${B}sentences${R} — print the reference text as it will be cued
  ${B}probe${R} — say what would be used, and do nothing
    ${D}Both take only the common options above.  Neither needs any audio;${R}
    ${D}sentences works from the EPUB alone.${R}

  ${B}lint${R} — check SRTs against the app's parser
    ${C}AUDIODIR${R} or ${C}FILE...${R}     a directory of .srt files, or named files

  ${B}Anywhere${R}
    ${C}-h, --help${R}            this manual
    ${C}--version${R}             print the version
    ${C}-s, --setup${R}           set this machine up, or check it — see
                          SETTING UP A MACHINE
    ${C}-s --rebuild${R}          discard the virtualenv and build it again

${C}ENVIRONMENT${R}
    ${C}JISHO_SUBS_VENV${R}       where the virtualenv lives
                          ${D}(default: ~/venv.shiroikuma-jisho-subtitles)${R}
    ${C}JISHO_SUBS_REPO${R}       where this checkout lives
                          ${D}(default: ~/git/shiroikuma-jisho-subtitles)${R}
    ${C}XDG_CACHE_HOME${R}        moves the transcript cache
    ${C}HF_HOME${R}               moves the downloaded speech models
    ${C}NO_COLOR${R}              plain output, no colour and no progress bar

${C}OUTPUT${R}
    One SRT per audio file, same basename, same directory.  Written to the
    app's actual parser contract, which is stricter than SubRip generally is
    and silently rewrites what it loads: timestamps must use commas, no
    byte-order mark, no empty cues, no two cues sharing a timestamp, no
    identical adjacent cues less than 500 ms apart, strictly ordered.

    ${C}${PROG} lint AUDIODIR${R} checks every one of those rules.

${C}CACHING${R}
    Transcripts and voice-activity results are cached in
    ${D}~/.cache/jisho-subs${R}, keyed by file content.  The first run of a book
    does the expensive work; later runs finish in seconds.  ${C}--force${R} redoes it.

${C}PERFORMANCE${R}
    Measured on this machine, per hour of audio:
      ${D}·${R} MP3 to M4B conversion   ~700x realtime  (all cores)
      ${D}·${R} transcription, GPU       ~75x realtime  (RTX 5090, large-v3)
      ${D}·${R} transcription, CPU        ~4x realtime  (24 cores, int8)
      ${D}·${R} pause snapping          ~450x realtime
    A 7¾-hour book takes about eight minutes end to end on the GPU.

${C}EXAMPLES${R}
    ${D}# Everything: convert if needed, transcribe, align, write.${R}
    ${PROG} ~/books/Lázár

    ${D}# Same, then delete the MP3s once each M4B checks out (asks first).${R}
    ${PROG} ~/books/Lázár -d

    ${D}# Unattended: convert, delete the MP3s, no prompt.${R}
    ${PROG} ~/books/Lázár -d -y

    ${D}# Language is read from the EPUB; state it only to override.${R}
    ${PROG} ~/books/Lázár -l de --report ~/tmp/lazar.txt

    ${D}# See how the book will be cut into cues, before touching any audio.${R}
    ${PROG} sentences ~/books/Lázár | less

    ${D}# Just fix the audio format, keeping the MP3s.${R}
    ${PROG} convert ~/books/Lázár

    ${D}# Check what the app will make of the result.${R}
    ${PROG} lint ~/books/Lázár/audio

${C}SETTING UP A MACHINE${R}  ${C}(-s)${R}
    ${C}${PROG} -s${R} makes a fresh Debian, Ubuntu or Tuxedo OS
    machine ready in one step, and on a machine that is already ready it just
    reports what it finds.

    ${B}When nothing is installed${R} it works out what is missing, installs the
    system packages through apt (asking for sudo only if something is actually
    needed), creates the virtualenv, installs this package into it in editable
    mode, and then verifies the result.

    ${B}When the environment already exists${R} it changes nothing.  It lists every
    component — system tools, the interpreter, each Python dependency, the GPU
    stack, the cached speech models — with a green check against each, and ends
    by saying whether the machine is ready.

    ${C}--rebuild${R} deletes the virtualenv and builds it again from scratch.  Only
    the virtualenv: your books, your subtitles and the transcript cache are
    never touched.

${C}REQUIREMENTS${R}
    ffmpeg and ffprobe on PATH.  A CUDA GPU is optional but turns hours into
    minutes.  The Python package lives in ${D}${VENV}${R}
    (override with JISHO_SUBS_VENV).

${C}EXIT STATUS${R}
    0 success · 1 error · 130 interrupted

${C}SEE ALSO${R}
    ${D}${REPO}/README.md${R}
EOF
}

# ---------------------------------------------------------------- setup ----
# Everything below runs *without* the virtualenv, because its whole job may be
# to create one.  Only bash, coreutils and whatever the base system ships.

SETUP_FAIL=0
SETUP_WARN=0

ok()   { printf '  %s✓%s %-22s %s\n' "$G" "$R" "$1" "${2:-}"; }
warn() { printf '  %s!%s %-22s %s\n' "$Y" "$R" "$1" "${2:-}"; SETUP_WARN=$((SETUP_WARN+1)); }
bad()  { printf '  %s✗%s %-22s %s\n' "$E" "$R" "$1" "${2:-}"; SETUP_FAIL=$((SETUP_FAIL+1)); }
sect() { printf '\n%s%s%s\n' "$C" "$1" "$R"; }

# Debian package names, and the test that says whether each is really usable.
apt_missing() {
    local missing=()
    command -v python3  >/dev/null 2>&1 || missing+=(python3)
    python3 -c 'import venv'   >/dev/null 2>&1 || missing+=(python3-venv)
    python3 -c 'import ensurepip' >/dev/null 2>&1 || missing+=(python3-venv)
    command -v ffmpeg   >/dev/null 2>&1 || missing+=(ffmpeg)
    command -v ffprobe  >/dev/null 2>&1 || missing+=(ffmpeg)
    printf '%s\n' "${missing[@]:-}" | awk 'NF' | sort -u
}

install_apt() {
    local pkgs=("$@")
    [[ ${#pkgs[@]} -eq 0 ]] && return 0
    command -v apt-get >/dev/null 2>&1 || {
        bad "apt-get" "not found — install manually: ${pkgs[*]}"
        return 1
    }
    printf '  %sinstalling:%s %s\n' "$Y" "$R" "${pkgs[*]}"
    local sudo_cmd=()
    if [[ $EUID -ne 0 ]]; then
        command -v sudo >/dev/null 2>&1 || { bad "sudo" "needed for apt"; return 1; }
        sudo_cmd=(sudo)
        printf '  %s(sudo will ask for your password)%s\n' "$D" "$R"
    fi
    "${sudo_cmd[@]}" apt-get update -qq                 || return 1
    "${sudo_cmd[@]}" apt-get install -y -qq "${pkgs[@]}" || return 1
    return 0
}

build_venv() {
    printf '  %screating%s %s\n' "$Y" "$R" "$VENV"
    python3 -m venv "$VENV" || { bad "venv" "python3 -m venv failed"; return 1; }
    printf '  %supgrading pip%s\n' "$D" "$R"
    "$VENV/bin/python" -m pip install --quiet --upgrade pip setuptools wheel \
        || { bad "pip" "could not upgrade"; return 1; }
    printf '  %sinstalling %s (editable, with the CUDA extra)%s\n' "$D" "$REPO" "$R"
    # Quoted: the extras bracket must not be read as a glob.
    "$VENV/bin/python" -m pip install --quiet -e "$REPO[cuda,dev]" \
        || { bad "pip install" "failed for $REPO"; return 1; }
    return 0
}

report_system() {
    sect "SYSTEM"
    if command -v python3 >/dev/null 2>&1; then
        ok "python3" "$(python3 -c 'import sys;print(".".join(map(str,sys.version_info[:3])))')"
    else
        bad "python3" "missing"
    fi
    python3 -c 'import venv' >/dev/null 2>&1 \
        && ok "python3-venv" "available" || bad "python3-venv" "missing"
    if command -v ffmpeg >/dev/null 2>&1; then
        ok "ffmpeg" "$(ffmpeg -version 2>/dev/null | head -1 | awk '{print $3}')"
    else
        bad "ffmpeg" "missing"
    fi
    command -v ffprobe >/dev/null 2>&1 \
        && ok "ffprobe" "$(ffprobe -version 2>/dev/null | head -1 | awk '{print $3}')" \
        || bad "ffprobe" "missing"
    if [[ -r /etc/os-release ]]; then
        ok "os" "$(. /etc/os-release; echo "${PRETTY_NAME:-unknown}")"
    fi
    ok "cores" "$(nproc 2>/dev/null || echo '?')"
}

report_gpu() {
    sect "GPU  ${D}(optional — the CPU path works, just slower)${R}"
    if ! command -v nvidia-smi >/dev/null 2>&1; then
        warn "nvidia-smi" "not present; transcription will use the CPU"
        return
    fi
    local out
    if ! out=$(nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>&1); then
        warn "nvidia driver" "$(printf '%s' "$out" | head -1)"
        return
    fi
    ok "gpu" "$(printf '%s' "$out" | head -1)"
    local n
    n=$("$VENV/bin/python" -c 'import ctranslate2;print(ctranslate2.get_cuda_device_count())' 2>/dev/null || echo 0)
    if [[ "$n" =~ ^[0-9]+$ ]] && (( n > 0 )); then
        ok "ctranslate2 cuda" "$n device(s) visible"
    else
        warn "ctranslate2 cuda" "no device visible; will fall back to the CPU"
    fi
}

report_packages() {
    sect "PYTHON ENVIRONMENT"
    if [[ ! -x "$VENV/bin/python" ]]; then
        bad "virtualenv" "$VENV missing"
        return
    fi
    ok "virtualenv" "$VENV"
    ok "interpreter" "$("$VENV/bin/python" -c 'import sys;print(".".join(map(str,sys.version_info[:3])))')"
    # Status captured explicitly: inside `if ! cmd`, $? is the negation's
    # result, not the interpreter's, which would silently report a broken
    # environment as ready.
    local rc=0
    set +e
    "$VENV/bin/python" - <<'PY'
import importlib.metadata as md
import importlib.util, os, sys

GREEN, RED, RESET, DIM = "\033[1;32m", "\033[1;31m", "\033[0m", "\033[2m"
if os.environ.get("NO_COLOR") or not sys.stderr.isatty():
    GREEN = RED = RESET = DIM = ""

REQUIRED = [
    ("jisho_subs",     "jisho-subs"),
    ("faster_whisper", "faster-whisper"),
    ("ctranslate2",    "ctranslate2"),
    ("rapidfuzz",      "RapidFuzz"),
    ("pysbd",          "pysbd"),
    ("num2words",      "num2words"),
    ("bs4",            "beautifulsoup4"),
    ("lxml",           "lxml"),
    ("numpy",          "numpy"),
]
OPTIONAL = [("nvidia.cublas", "nvidia-cublas-cu12"),
            ("nvidia.cudnn",  "nvidia-cudnn-cu12"),
            ("pytest",        "pytest")]

bad = 0
def line(mod, dist, required):
    global bad
    try:
        version = md.version(dist)
    except md.PackageNotFoundError:
        version = None
    found = importlib.util.find_spec(mod) is not None
    if found and version:
        print("  %s✓%s %-22s %s" % (GREEN, RESET, dist, version))
    elif found:
        print("  %s✓%s %-22s %spresent%s" % (GREEN, RESET, dist, DIM, RESET))
    elif required:
        print("  %s✗%s %-22s missing" % (RED, RESET, dist)); bad += 1
    else:
        print("  %s✗%s %-22s %smissing (optional)%s" % (RED, RESET, dist, DIM, RESET))

for mod, dist in REQUIRED:
    line(mod, dist, True)
for mod, dist in OPTIONAL:
    line(mod, dist, False)

try:
    import jisho_subs
    print("  %s✓%s %-22s %s" % (GREEN, RESET, "editable checkout",
                                os.path.dirname(os.path.dirname(jisho_subs.__file__))))
except Exception:
    pass
# Exit status carries the count, so the shell can total it honestly.
sys.exit(min(bad, 120))
PY
    rc=$?
    set -e
    # The exit status is the number of required packages that were missing.
    SETUP_FAIL=$((SETUP_FAIL + rc))
}

report_models() {
    sect "SPEECH MODELS  ${D}(downloaded on first use)${R}"
    local hub="${HF_HOME:-$HOME/.cache/huggingface}/hub"
    if [[ -d "$hub" ]]; then
        local found=0
        for d in "$hub"/models--Systran--faster-whisper-*; do
            [[ -e "$d" ]] || continue
            found=1
            ok "$(basename "$d" | sed 's/models--Systran--faster-whisper-/whisper /')" \
               "$(du -sh "$d" 2>/dev/null | cut -f1)"
        done
        if (( ! found )); then
            warn "whisper models" "none cached yet; the first run downloads one"
        fi
    else
        warn "whisper models" "none cached yet; the first run downloads one"
    fi
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/jisho-subs"
    if [[ -d "$cache" ]]; then
        ok "transcript cache" "$(find "$cache" -name '*.json' 2>/dev/null | wc -l) entries, $(du -sh "$cache" 2>/dev/null | cut -f1)"
    else
        ok "transcript cache" "empty (created on first run)"
    fi
}

do_setup() {
    local rebuild=${1:-0}
    printf '%s%s%s — environment setup\n' "$Y" "$PROG" "$R"

    if (( rebuild )) && [[ -d "$VENV" ]]; then
        sect "REBUILD"
        printf '  %sremoving%s %s\n' "$Y" "$R" "$VENV"
        rm -rf "$VENV"
    fi

    local existed=0
    [[ -x "$VENV/bin/python" ]] && existed=1 || true

    if (( ! existed )); then
        sect "INSTALLING SYSTEM PACKAGES"
        local missing
        mapfile -t missing < <(apt_missing)
        if [[ ${#missing[@]} -eq 0 ]]; then
            ok "system packages" "already present"
        else
            install_apt "${missing[@]}" || {
                printf '\n%sSetup could not install the system packages.%s\n' "$E" "$R"
                return 1
            }
            ok "system packages" "installed"
        fi

        sect "BUILDING THE VIRTUALENV"
        build_venv || {
            printf '\n%sSetup failed while building the virtualenv.%s\n' "$E" "$R"
            return 1
        }
        ok "virtualenv" "built"
    fi

    report_system
    report_packages
    report_gpu
    report_models

    sect "TOOL"
    if [[ -x "$VENV/bin/python" ]] && "$VENV/bin/python" -m jisho_subs --version >/dev/null 2>&1; then
        ok "version" "$("$VENV/bin/python" -m jisho_subs --version 2>&1 | awk '{print $NF}')"
        ok "repository" "$REPO"
    else
        bad "the tool" "does not run"
    fi
    if [[ -L "$HOME/0/bin/$PROG" || -x "$HOME/0/bin/$PROG" ]]; then
        ok "on PATH" "~/0/bin/$PROG"
    else
        warn "on PATH" "not linked; ln -s $REPO/bin/$PROG ~/0/bin/"
    fi

    printf '\n'
    if (( SETUP_FAIL )); then
        printf '%s  ✗ %d problem(s) — not ready.%s  Re-run with --rebuild to start over.\n' \
            "$E" "$SETUP_FAIL" "$R"
        return 1
    fi
    if (( existed )); then
        printf '%s  ✓ Everything is present. Ready to go.%s' "$G" "$R"
    else
        printf '%s  ✓ Setup complete. Ready to go.%s' "$G" "$R"
    fi
    if (( SETUP_WARN )); then
        printf '  %s(%d optional item(s) missing)%s' "$D" "$SETUP_WARN" "$R"
    fi
    printf '\n\n  Try it:  %s%s BOOKDIR%s\n' "$C" "$PROG" "$R"
    return 0
}

case "${1:-}" in
    -h|--help|help|"")
        print_help
        exit 0
        ;;
    -s|--setup)
        rebuild=0
        [[ "${2:-}" == "--rebuild" || "${2:-}" == "-r" ]] && rebuild=1
        do_setup "$rebuild"
        exit $?
        ;;
esac

[[ -x "$VENV/bin/python" ]] || die "no interpreter at $VENV/bin/python
        Create it with:
          python3 -m venv $VENV
          $VENV/bin/pip install -e '$REPO[cuda]'"

command -v ffmpeg  >/dev/null 2>&1 || die "ffmpeg not found on PATH"
command -v ffprobe >/dev/null 2>&1 || die "ffprobe not found on PATH"

exec "$VENV/bin/python" -m jisho_subs "$@"
